FROM python@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt /opt/template-deps/requirements.txt
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes \
    --index-url https://pypi.org/simple -r /opt/template-deps/requirements.txt
USER 1000:1000
WORKDIR /workspace/backend
